#!/usr/bin/env bash
# Hyprdrive Settings launcher. Installed to ~/.local/bin by install-fragments.sh.
#
# It does one thing before the window exists, and that thing is the reason it is
# a script and not a bare Exec= line: `hdmon check` puts back a monitor change
# nobody confirmed. The countdown normally runs in a detached watcher, but a
# watcher can be killed with the app (or with the machine), and the honest
# fallback is that the NEXT thing to open the settings is what undoes it. So the
# revert happens here, before anything is drawn, whether or not the app that
# started it ever ran again.
set -eu
REPO=${HYPRDRIVE_REPO:-$HOME/overview-cpp}
QS_CONFIG=${HYPRDRIVE_QS_CONFIG:-$HOME/.config/quickshell/ii}
export HYPRDRIVE_REPO=$REPO

if [ ! -f "$REPO/scripts/hdctl.py" ]; then
    echo "hyprdrive-settings: no $REPO/scripts/hdctl.py -- set HYPRDRIVE_REPO" >&2
    exit 1
fi

python3 "$REPO/scripts/hdmon.py" check || true

exec qs -p "$QS_CONFIG/hyprdrive-settings.qml" "$@"
