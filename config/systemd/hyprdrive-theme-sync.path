[Unit]
Description=Hyprdrive: watch ii's matugen palette
Documentation=man:hyprdrive(1)

# The whole trigger. matugen rewrites this file on every wallpaper change (it is
# ii's own [templates.m3colors] output), systemd notices the close-after-write
# and starts the service. Measured on this guest 2026-08-12: the unit fires
# ~170ms after matugen returns, and re-arms for the next swap.
#
# A path unit rather than a daemon on purpose -- there is no state to hold
# between swaps, and the smallest thing that can watch a file without being a
# process is the one that cannot leak, wedge, or need restarting after a crash.
[Path]
PathChanged=%h/.local/state/quickshell/user/generated/colors.json
Unit=hyprdrive-theme-sync.service

[Install]
WantedBy=default.target
