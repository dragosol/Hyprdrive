[Unit]
Description=Hyprdrive: re-derive the theme fragment from the matugen palette

[Service]
Type=oneshot
# @REPO@ is substituted by scripts/install-fragments.sh with the checkout it was
# run from, so the unit names a real path instead of assuming one.
ExecStart=@REPO@/scripts/theme-sync.py

# The script discovers HYPRLAND_INSTANCE_SIGNATURE itself (a path unit inherits
# no session environment), so nothing here needs importing. XDG_RUNTIME_DIR is
# already in the user manager's environment.
