[Unit]
Description=Hyprdrive wallpaper slideshow

# NOT the guest's hyprwall.timer, and that separation is deliberate. That one is
# the test rig's palette-neutral rotation, which the gate suite holds still for a
# whole run; this is the product's slideshow, which re-derives the palette on
# purpose. Installing this one leaves that one exactly where it was.
[Timer]
OnActiveSec=1min
OnUnitActiveSec=1min

[Install]
WantedBy=timers.target
