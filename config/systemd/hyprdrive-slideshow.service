[Unit]
Description=Hyprdrive wallpaper slideshow tick
Documentation=file://@REPO@/scripts/hdwall.py

[Service]
Type=oneshot
# It fires once a minute whatever the interval is, and decides for itself
# whether enough time has passed -- the settings are read out of the app's store
# on every tick. That is why changing the interval needs no unit rewritten and no
# daemon reloaded, and why a tick with the slideshow off costs one exit(0).
ExecStart=/usr/bin/python3 @REPO@/scripts/hdwall.py tick
