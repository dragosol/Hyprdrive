[Desktop Entry]
Type=Application
Name=Hyprdrive Settings
GenericName=Overview and Dock Settings
Comment=Overview, dock, blur, monitors and shell -- one place, written through the config fragments
Exec=hyprdrive-settings
Icon=preferences-desktop
Terminal=false
Categories=Settings;DesktopSettings;
Keywords=hyprdrive;overview;dock;blur;monitor;hyprland;
StartupNotify=true
# STILL DANGLING, and the blocker is upstream rather than here. The window's
# real Wayland app_id is `org.quickshell` -- Qt takes it from
# QGuiApplication::desktopFileName(), quickshell sets that once per process, and
# 0.3.0 exposes Quickshell.appId read-only with no `qs` flag to override it. So
# there is no value that both matches this window and does not ALSO claim
# illogical-impulse's bar, its own settings window and every other surface in the
# shell. `org.quickshell` here would be worse than a wrong answer: it would hand
# the whole shell's windows to this entry.
# Left as the name the window OUGHT to report, so that the day quickshell can set
# an app id this line is already correct. Everything that has to select this
# window today does it by title instead: config/hyprdrive/35-settings-app.lua's
# no_anim rule, and x64, the one gate that opens the window and films it. The
# other settings gates (x60, x62, x63) never map it -- they exercise the schema
# and the write path -- so nothing else in the tree depends on this line.
StartupWMClass=hyprdrive-settings
