#!/usr/bin/env python3
"""Hyprdrive settings back end -- the Omarchy panel's and the standalone app's.

Live preview is `hyprctl eval hl.config(...)`. Durable writes land in
~/.config/hypr/hyprdrive/40-panel.lua (keys) and 35-gestures.lua (gestures).
AC/battery profiles live in ~/.local/state/hyprdrive/panel.json.

ONE BACK END, TWO DESKTOPS (native port, audit A19/A20). Both front ends --
omarchy-plugin/HyprdrivePanel.qml in the Omarchy shell and settings/ on plain
Hyprland -- run this same file. Where the two desktops differ it asks
integration() (Integration.hpp's answer, through scripts/hyprdrive-integration)
and never stat()s an Omarchy path of its own:
  - compositor animations back on: Omarchy's looknfeel leaves on Omarchy, a
    snapshot of the user's own `hyprctl animations -j` elsewhere;
  - Mosaic's chords: plugin:hyprdrive:mosaic:cycle_bind / focus_binds, whose
    "auto" means Omarchy's Super+L / Super+arrows there and nothing here;
  - where Super+L's per-workspace layouts persist (layouts_store()).
"""
from __future__ import annotations

