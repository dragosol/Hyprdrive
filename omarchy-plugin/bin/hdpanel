def eval_lua(code):
    r = hyprctl_run("eval", code)
    if r is None:
        return False
    text = (r.stdout or "") + (r.stderr or "")
    if r.returncode != 0 or text.lstrip().startswith("error:"):
        sys.stderr.write(text if text.endswith("\n") else text + "\n")
        return False
    return True


def anim_leaf_lua(leaf, enabled, speed=None, curve=None, style=None):
    fields = ["leaf = %s" % lua_lit(leaf), "enabled = %s" % lua_lit(bool(enabled))]
    if enabled and speed is not None:
        fields.append("speed = %s" % lua_lit(speed))
        if curve:
            fields.append("bezier = %s" % lua_lit(curve))
        if style:
            fields.append("style = %s" % lua_lit(style))
    return "hl.animation({ %s })" % ", ".join(fields)


# "Slide between desktops": the workspaces leaf as the switch turns it on.
# easeOutQuint is Omarchy's windows/layers curve; a config without it gets
# Hyprland's "default" bezier rather than a name that is not there.
SLIDE_KEY = "animations:workspaces"


def workspace_slide_lua(on):
    _, beziers = anim_tree()
    curve = "easeOutQuint" if "easeOutQuint" in beziers else "default"
    return anim_leaf_lua("workspaces", on, 4.0, curve, "slide")


def workspace_slide_live():
    """The workspaces leaf's live state, or None."""
    leaves, _ = anim_tree()
    for a in leaves:
        if a.get("name") == "workspaces":
            return bool(a.get("enabled"))
    return None


# Extra leaves Omarchy does not override; disable them explicitly so they
# cannot keep animating via inherit-as-true (internalEnabled -1).
DISABLE_EXTRA_LEAVES = ("windowsMove",)


# ------------------------------------------------- animations off Omarchy (A19)
#
# OMARCHY_ANIM_LEAVES is Omarchy's looknfeel.lua, and its beziers
# (easeOutQuint, almostLinear, quick) exist only because looknfeel defines
# them: replayed on plain Hyprland it named curves that are not there. So off
# Omarchy, "animations back on" restores the USER'S tree instead -- every
# overridden leaf as `hyprctl animations -j` reported it the moment before they
# were switched off, kept in panel.json as animSnapshot. With no snapshot (they
# were off before this ran, e.g. since the last boot via 40-panel.lua) the
# honest restore is a re-parse of the user's own config: set_keys reloads.

def anim_tree():
    """-> (leaves, bezier names) from `hyprctl animations -j`, or ([], set())."""
    try:
        d = json.loads(hyprctl("animations", "-j") or "[]")
    except ValueError:
        return [], set()
    if not isinstance(d, list) or not d or not isinstance(d[0], list):
        return [], set()
    leaves = [a for a in d[0] if isinstance(a, dict) and a.get("name") and not str(a["name"]).startswith("__")]
    beziers = {b.get("name") for b in (d[1] if len(d) > 1 and isinstance(d[1], list) else []) if isinstance(b, dict)}
    return leaves, beziers


def snapshot_animations(store):
    """Remember the user's animation tree before hyprdrive switches it off.

    Only while animations are still on: a snapshot of an already-disabled tree
    would "restore" everything to off. Overridden leaves only -- the rest
    inherit from their parent and come back with it."""
    if omarchy() or getoption("animations:enabled") in (0, False):
        return
    leaves, _ = anim_tree()
    snap = [{k: a.get(k) for k in ("name", "enabled", "speed", "bezier", "style")} for a in leaves if a.get("overridden")]
    if snap:
        store["animSnapshot"] = snap


def anim_disable_names(store):
    """Every leaf to switch off: Omarchy's list there; elsewhere every leaf the
    user overrides (live or remembered), plus global, which the rest inherit."""
    if omarchy():
        return [leaf for leaf, *_ in OMARCHY_ANIM_LEAVES] + list(DISABLE_EXTRA_LEAVES)
    names = ["global"]
    for a in (store or {}).get("animSnapshot") or []:
        if a.get("name") and a["name"] not in names:
            names.append(a["name"])
    for leaf in DISABLE_EXTRA_LEAVES:
        if leaf not in names:
            names.append(leaf)
    return names


def anim_restore_lines(store):
    """hl.animation lines putting the remembered tree back, or None (no
    snapshot: the caller reloads). A curve that is gone since the snapshot falls
    back to Hyprland's own `default` rather than naming a missing bezier."""
    if omarchy():
        return [anim_leaf_lua(leaf, on, speed, curve, style) for leaf, on, speed, curve, style in OMARCHY_ANIM_LEAVES]
    snap = (store or {}).get("animSnapshot") or []
    if not snap:
        return None
    _, beziers = anim_tree()
    lines = []
    for a in snap:
        curve = a.get("bezier") or None
        if curve and beziers and curve not in beziers:
            curve = "default"
        speed = a.get("speed")
        lines.append(anim_leaf_lua(a["name"], bool(a.get("enabled")), speed if speed else None, curve, a.get("style") or None))
    # The extra leaves were switched off explicitly, which makes them
    # overridden: they no longer inherit, so they come back on explicitly too,
    # at global's speed and curve (what they inherited before).
    named = {a.get("name") for a in snap}
    glob = next((a for a in snap if a.get("name") == "global"), None) or {}
    for leaf in DISABLE_EXTRA_LEAVES:
        if leaf not in named:
            curve = glob.get("bezier") or None
            if curve and beziers and curve not in beziers:
                curve = "default"
            lines.append(anim_leaf_lua(leaf, True, glob.get("speed") or 1, curve or "default"))
    return lines


def compositor_anim_lua(enabled, store=None):
    """-> (lua, restored). restored is False when the leaves could not be put
    back from a snapshot and only a reload will (off Omarchy, no snapshot)."""
    lines = ["hl.config({ animations = { enabled = %s } })" % lua_lit(bool(enabled))]
    restored = True
    if enabled:
        back = anim_restore_lines(store)
        if back is None:
            restored = False
        else:
            lines += back
    else:
        for leaf in anim_disable_names(store):
            lines.append(anim_leaf_lua(leaf, False))
    return "\n".join(lines), restored


# Set by apply_live_many when animations came back on with nothing to restore
# them from; set_keys reloads once 40-panel.lua no longer turns them off.
_NEEDS_RELOAD = False


def apply_live_many(pairs, store=None):
    """Omarchy uses the Lua config parser; hyprctl keyword is a no-op. eval hl.config."""
    global _NEEDS_RELOAD
    anim = None
    slide = None
    rest = []
    for key, value in pairs:
        if key == "animations:enabled":
            anim = bool(value)
        elif key == SLIDE_KEY:
            slide = bool(value)
        else:
            rest.append((key, value))
    if rest:
        tree = {}
        for key, value in rest:
            nest_set(tree, key, value)
        if not eval_lua("hl.config(%s)" % emit_table(tree, 0)):
            return False
    if anim is not None:
        store = store if store is not None else load_store()
        if not anim:
            snapshot_animations(store)
        # Live on must restore leaves because looknfeel.lua (or the user's own
        # animation lines) is not re-run.
        lua, restored = compositor_anim_lua(anim, store)
        if not eval_lua(lua):
            return False
        if not restored:
            _NEEDS_RELOAD = True
        if anim and slide is None and SLIDE_KEY in store.get("keys", {}):
            # The restore put the leaves back as they were; a slide the
            # settings own goes back to its switch.
            slide = bool(store["keys"][SLIDE_KEY])
    if slide is not None:
        if not eval_lua(workspace_slide_lua(slide)):
            return False
    return True


def apply_live(key, value):
    return apply_live_many([(key, value)])


def on_battery():
    root = pathlib.Path("/sys/class/power_supply")
    if not root.is_dir():
        return False
    for p in root.iterdir():
        t = (p / "type").read_text().strip() if (p / "type").exists() else ""
        if t == "Mains" and (p / "online").exists():
            return (p / "online").read_text().strip() == "0"
    for p in root.iterdir():
        t = (p / "type").read_text().strip() if (p / "type").exists() else ""
        if t == "Battery" and (p / "status").exists():
            if (p / "status").read_text().strip() == "Discharging":
                return True
    return False


def load_store():
    if STORE.exists():
        try:
            return json.loads(STORE.read_text())
        except ValueError:
            pass
    return {
        "keys": {},
        "gestures": None,
        "profiles": {"ac": {}, "battery": {}},
        "profileMode": "auto",
        "roundedRadius": 24,
    }


def replace_file(path, text):
    """Atomic replace that never widens access (marketplace review, #11012).

    The temp file is CREATED with the destination's mode -- 0600 when there is
    no destination yet -- so a private file is never replaced by a
    umask-default 0644 one. The panel ships on its own (the marketplace copies
    omarchy-plugin/), so this is its own copy of scripts/fragment.py's
    replace_file; scripts/private_modes_test.py checks both."""
    path = pathlib.Path(path)
    try:
        mode = stat.S_IMODE(path.stat().st_mode)
    except FileNotFoundError:
        mode = 0o600
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.unlink(missing_ok=True)  # a leftover temp would keep ITS mode
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    with os.fdopen(fd, "w") as fh:
        fh.write(text)
    os.chmod(tmp, mode)  # the umask can only have narrowed it; restore it exactly
    os.replace(tmp, path)


def save_store(s):
    STATE.mkdir(parents=True, exist_ok=True)
    replace_file(STORE, json.dumps(s, indent=1, sort_keys=True) + "\n")


def write_fragment(path, text):
    # Hyprland reloads its whole config (~100 ms stall) on any write under
    # ~/.config/hypr, so leave an unchanged fragment untouched.
    try:
        if path.read_text() == text:
            return
    except OSError:
        pass
    replace_file(path, text)


def lua_lit(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)) and not isinstance(v, bool):
        return repr(v) if isinstance(v, float) else str(int(v))
    s = str(v).replace("\\", "\\\\").replace("'", "\\'")
    return "'" + s + "'"


def nest_set(tree, dotted, value):
    parts = dotted.split(":")
    cur = tree
    for p in parts[:-1]:
        cur = cur.setdefault(p, {})
    cur[parts[-1]] = value


def emit_table(obj, indent=8):
    pad = " " * indent
    if isinstance(obj, dict):
        lines = ["{"]
        for k, v in obj.items():
            if isinstance(v, dict):
                lines.append("%s%s = %s," % (pad + "    ", k, emit_table(v, indent + 4)))
            else:
                lines.append("%s%s = %s," % (pad + "    ", k, lua_lit(v)))
        lines.append(pad + "}")
        return "\n".join(lines)
    return lua_lit(obj)


def compose_fragment(machine, existing_path):
    raw = ""
    if existing_path.exists():
        text = existing_path.read_text()
        b = next((i for i, l in enumerate(text.splitlines()) if l.strip().startswith("-- BEGIN raw-snippet")), None)
        if b is not None:
            lines = text.splitlines()
            e = next((i for i in range(b + 1, len(lines)) if lines[i].strip() == END), None)
            if e is not None:
                raw = "\n".join(lines[b + 1:e])
    return machine.rstrip("\n") + "\n\n" + BEGIN + "\n" + raw.strip("\n") + ("\n" if raw.strip("\n") else "") + END + "\n"


def write_panel_fragment(store):
    keys = dict(store.get("keys", {}))
    anim = keys.pop("animations:enabled", None)
    slide = keys.pop(SLIDE_KEY, None)
    body = [
        "-- hyprdrive fragment 40-panel -- written by the Hyprdrive settings (hdpanel).",
        "-- MACHINE-OWNED above the raw-snippet marker.",
    ]
    # animations.enabled is a compositor key. Keep it (and leaf disables)
    # outside hyprdrive_loaded() so a reload cannot re-enable Omarchy's
    # looknfeel leaves (or the user's own) before the plugin guard runs.
    if anim is not None:
        body.append("hl.config({ animations = { enabled = %s } })" % lua_lit(bool(anim)))
        if not anim:
            for leaf in anim_disable_names(store):
                body.append(anim_leaf_lua(leaf, False))
    # After the user's own animation lines (fragments load last), so the
    # switch wins over a looknfeel that turned the leaf off.
    if slide is not None and anim is not False:
        body.append(workspace_slide_lua(slide))
    tree = {}
    for k, v in keys.items():
        nest_set(tree, k, v)
    mosaic = mosaic_lua(store)
    binds = keybinds_lua(store)
    if tree or mosaic or binds:
        body.append("if hyprdrive_loaded and hyprdrive_loaded() then")
        if tree:
            body.append("    hl.config(%s)" % emit_table(tree, 4))
        body.extend("    " + line if line else "" for line in mosaic + binds)
        body.append("end")
    body.append("")
    FRAGDIR.mkdir(parents=True, exist_ok=True)
    path = FRAGDIR / PANEL_FRAG
    write_fragment(path, compose_fragment("\n".join(body), path))
    return path


# ---------------------------------------------------------------- Keybinds
#
# The Keybinds section's switches that BIND something (Minimize, the
# settings, the dock's Super+1..0). Every bind is written into 40-panel.lua,
# inside hyprdrive_loaded() so a missing plugin binds nothing and unbinds
# nothing, and each action is BUILT before its chord is unbound: if the plugin
# cannot make it, the chord keeps whatever the config bound there. A bind is
# parse-time, so a change reloads (commit_store sees the bind lines change);
# turning one off is its absence, and the reload gives the chord back.

def bind_switches(store):
    owned = store.get("binds") or {}
    return {k: bool(owned.get(k, spec[0])) for k, spec in BIND_SWITCHES.items()}


def guarded_binds(binds):
    """[(chord, action_lua, description)] -> Lua that binds all of them, or none.

    The actions are made first (hl.plugin.hyprdrive.* raises when the plugin's
    dispatcher is missing); only when every one exists are the chords unbound
    -- a second bind of a chord does not replace the first -- and bound."""
    lines = ["do"]
    for i, (_, action, _) in enumerate(binds):
        lines.append("    local ok%d, a%d = pcall(function() return %s end)" % (i, i, action))
    lines.append("    if %s then" % " and ".join("ok%d" % i for i in range(len(binds))))
    for chord, _, _ in binds:
        lines.append("        hl.unbind(%s)" % lua_lit(chord))
    for i, (chord, _, desc) in enumerate(binds):
        lines.append("        hl.bind(%s, a%d, { description = %s })" % (lua_lit(chord), i, lua_lit(desc)))
    lines.append("    end")
    lines.append("end")
    return lines


def keybinds_lua(store):
    lines = []
    switches = bind_switches(store)
    chords = bind_chords(store)
    for bid, (_, _, action, desc) in BIND_SWITCHES.items():
        chord = chords[bid]
        if switches[bid]:
            lines += ["", "-- Keybinds: %s (%s)." % (desc, chord)] + guarded_binds([(chord, action, desc)])
    if bool((store.get("keys") or {}).get(HOT_KEYS, False)):
        lines += [
            "",
            "-- Keybinds: dock hotkeys. Super+1..0 open or focus the dock's first",
            "-- ten apps instead of what the config bound there.",
        ] + guarded_binds([
            ("SUPER + code:%d" % (n + 9), "hl.plugin.hyprdrive.hotkey('%d')" % n, "Dock app %d" % n)
            for n in range(1, 11)
        ])
    return lines


# ------------------------------------------------------------------ Mosaic
#
# The switch does three things outside hyprdrive's own keys, all of them in
# 40-panel.lua so a reload or a reboot replays them and turning Mosaic off is
# just their absence:
#   - Super+L runs hd-layout-cycle instead of Omarchy's two-way toggle;
#   - with "default" on, general.layout = "mosaic" for every workspace that
#     has no rule of its own;
#   - both sit inside hyprdrive_loaded(), because "mosaic" is a layout only
#     the loaded plugin provides.

def mosaic_state(store):
    """-> (enabled, default). Default without enabled means nothing."""
    keys = store.get("keys", {})
    on = bool(keys.get(MOSAIC_ON, False))
    return on, on and bool(keys.get(MOSAIC_DEFAULT, False))


def chord_setting(store, key):
    """A Mosaic chord key's value: the panel's own choice, else the live
    config (a hyprland.lua may set it), else "auto"."""
    v = (store.get("keys") or {}).get(key)
    if v is None:
        v = getoption(key)
    v = str(v or "").strip()
    return "auto" if v in ("", "[[EMPTY]]") else v


def mosaic_chords(store):
    """-> (cycle chord or "", focus modifiers or "", auto_cycle, auto_focus).

    The cycle's "auto" is Super+L everywhere. The focus binds' "auto" is
    resolved at PARSE time, in the fragment (hyprdrive_omarchy()), so a
    desktop that gains or loses Omarchy is right on its next reload; the
    returned modifier for it is Omarchy's, to be wrapped in that check."""
    cycle = chord_setting(store, MOSAIC_CYCLE)
    focus = chord_setting(store, MOSAIC_FOCUS)
    auto_cycle, auto_focus = cycle == "auto", focus == "auto"
    if auto_cycle:
        cycle = CYCLE_CHORD
    if auto_focus:
        focus = OMARCHY_FOCUS_MODS
    if cycle.lower() in ("none", "off", "false", "0"):
        cycle = ""
    if focus.lower() in ("none", "off", "false", "0"):
        focus = ""
    return cycle, focus, auto_cycle, auto_focus


def mosaic_lua(store):
    on, default = mosaic_state(store)
    lines = []
    if on:
        cycle, focus, auto_cycle, auto_focus = mosaic_chords(store)

        def guarded(auto, body):
            # The focus binds' "auto" takes the arrows only on Omarchy, where
            # they replace the movefocus binds Omarchy ships; elsewhere the
            # arrows are the user's.
            if not body:
                return []
            if not auto:
                return body
            return ["if hyprdrive_omarchy and hyprdrive_omarchy() then"] + ["    " + b if b else "" for b in body] + ["end"]

        if cycle:
            lines += [
                "",
                "-- Mosaic: %s cycles dwindle -> scrolling -> mosaic. A second bind" % cycle,
                "-- of a chord does not replace the first (both would fire), so drop",
                "-- whatever had it first -- on Omarchy its two-way layout toggle, the",
                "-- unbind-then-bind its bindings.lua template documents. Mosaic off",
                "-- removes these lines, and the next parse binds the old one untouched.",
                "-- The chord is plugin:hyprdrive:mosaic:cycle_bind (auto = Super+L on",
                "-- every desktop; \"none\" keeps a Super+L of your own).",
            ]
            # Not desktop-guarded: the chord is the same on both. It sits in
            # the hyprdrive_loaded() block like everything else here.
            lines += guarded(False, [
                "hl.unbind(%s)" % lua_lit(cycle),
                "hl.bind(%s, hl.dsp.exec_cmd(%s), { description = %s })" % (
                    lua_lit(cycle), lua_lit(shlex.quote(str(LAYOUT_CYCLE))), lua_lit("Cycle workspace layout")),
            ])
        if focus:
            lines += [
                "",
                "-- Mosaic: %s+arrows move focus, and %s+Shift+arrows swap windows," % (focus, focus),
                "-- by position on a mosaic desktop (its bunched windows rarely share",
                "-- the edges Hyprland's movefocus and swapwindow look for), and fall",
                "-- through to them everywhere else.",
                "-- plugin:hyprdrive:mosaic:focus_binds (auto = SUPER on Omarchy only).",
            ]
            body = []
            for arrow, d, word in (("LEFT", "l", "left"), ("RIGHT", "r", "right"), ("UP", "u", "up"), ("DOWN", "d", "down")):
                chord = "%s + %s" % (focus, arrow)
                body += [
                    "hl.unbind(%s)" % lua_lit(chord),
                    "hl.bind(%s, hl.plugin.hyprdrive.focus(%s), { description = %s })" % (lua_lit(chord), lua_lit(d), lua_lit("Focus on %s window" % word)),
                ]
            # The same keys with Shift swap (Omarchy's own descriptions), unless
            # the focus modifier already has Shift in it.
            if "SHIFT" not in focus.upper():
                for arrow, d, desc in (("LEFT", "l", "Swap window to the left"), ("RIGHT", "r", "Swap window to the right"), ("UP", "u", "Swap window up"),
                                       ("DOWN", "d", "Swap window down")):
                    chord = "%s + SHIFT + %s" % (focus, arrow)
                    body += [
                        "hl.unbind(%s)" % lua_lit(chord),
                        "hl.bind(%s, hl.plugin.hyprdrive.swap(%s), { description = %s })" % (lua_lit(chord), lua_lit(d), lua_lit(desc)),
                    ]
            lines += guarded(auto_focus, body)
    if default:
        lines += [
            "",
            "-- Mosaic is the default: workspaces with no layout of their own start in it.",
            "-- Loaded after looknfeel.lua / the user's general block, so this wins; off,",
            "-- theirs stands.",
            "hl.config({ general = { layout = 'mosaic' } })",
        ]
    return lines


def native_layouts():
    """{workspace id: layout} from 45-workspace-layouts.lua (off Omarchy)."""
    try:
        text = NATIVE_LAYOUTS.read_text()
    except OSError:
        return {}
    return {m.group(1): m.group(2) for m in LAYOUT_RULE.finditer(text)}


def write_native_layouts(chosen):
    """The fragment hd-layout-cycle keeps, rewritten whole. Same header and
    format as the script's (it parses this back)."""
    def num(w):
        try:
            return (0, int(w))
        except ValueError:
            return (1, w)
    lines = [
        "-- hyprdrive fragment 45-workspace-layouts -- each workspace's tiled layout,",
        "-- as the layout cycle (hd-layout-cycle) last left it. Written by hyprdrive;",
        "-- one line per workspace. Not used on Omarchy, which keeps its own.",
    ]
    lines += ['hl.workspace_rule({ workspace = "%s", layout = "%s" })' % (w, chosen[w]) for w in sorted(chosen, key=num)]
    FRAGDIR.mkdir(parents=True, exist_ok=True)
    write_fragment(NATIVE_LAYOUTS, "\n".join(lines) + "\n")


def revert_mosaic_workspaces(fallback, chosen_too):
    """Move workspaces off mosaic, live.

    A workspace on mosaic only because it was the default goes back to the
    restored default (`fallback`). One that Super+L put on mosaic has
    Omarchy's state file saying so; with `chosen_too` (Mosaic itself is going
    away) that file, which every parse replays, is rewritten to dwindle -- the
    cycle's first mode and Omarchy's own default -- and the workspace follows.
    Without it (only "default" turned off) a chosen mosaic stays. Off Omarchy
    the record is 45-workspace-layouts.lua instead, handled the same way.
    """
    persisted = set()
    if omarchy():
        if OMARCHY_LAYOUTS.is_dir():
            for f in sorted(OMARCHY_LAYOUTS.glob("*.lua")):
                try:
                    text = f.read_text()
                except OSError:
                    continue
                if '"mosaic"' not in text:
                    continue
                persisted.add(f.stem)
                if chosen_too:
                    f.write_text('hl.workspace_rule({ workspace = "%s", layout = "dwindle" })\n' % f.stem)
    else:
        # Our own fragment (A18): the same rewrite, one line per workspace.
        chosen = native_layouts()
        persisted = {w for w, l in chosen.items() if l == "mosaic"}
        if chosen_too and persisted:
            write_native_layouts({w: ("dwindle" if l == "mosaic" else l) for w, l in chosen.items()})
    try:
        workspaces = json.loads(hyprctl("-j", "workspaces") or "[]")
    except ValueError:
        workspaces = []
    rules = []
    for ws in workspaces:
        wid = str(ws.get("id", ""))
        if ws.get("tiledLayout") != "mosaic" or not wid.lstrip("-").isdigit():
            continue
        if wid in persisted and not chosen_too:
            continue
        layout = "dwindle" if wid in persisted else fallback
        rules.append("hl.workspace_rule({ workspace = %s, layout = %s })" % (lua_lit(wid), lua_lit(layout)))
    if rules:
        eval_lua("\n".join(rules))


def mosaic_before_write(store, before):
    """Bookkeeping that has to happen before 40-panel.lua changes."""
    was_on, was_default = before
    on, default = mosaic_state(store)
    if default and not was_default:
        # Remember what default it displaces, for the live restore below.
        # The durable restore needs no record: looknfeel.lua still sets it.
        cur = getoption("general:layout")
        if isinstance(cur, str) and cur and cur != "mosaic":
            store["mosaicPrevLayout"] = cur
    if (was_on and not on) or (was_default and not default):
        revert_mosaic_workspaces(store.get("mosaicPrevLayout") or "dwindle", chosen_too=was_on and not on)


def mosaic_after_write(store, before, binds_changed=False):
    """40-panel.lua changed its Mosaic lines: make them live.

    Super+L and general.layout follow from a parse of the config, so this
    reloads explicitly, autoreload or not. MEASURED 2026-10-11: with
    misc:disable_autoreload false, writing 40-panel.lua (a file the config
    `require`s, not hyprland.lua itself) did NOT re-parse -- Mosaic was on, the
    fragment had the new Super+L, and Hyprland kept Omarchy's bind until an
    explicit `hyprctl reload`. One ~100 ms hitch, and only when Mosaic's own
    switches change.
    """
    if mosaic_state(store) == before and not binds_changed:
        return
    hyprctl("reload")
    was_default = before[1]
    if was_default and not mosaic_state(store)[1]:
        # The reload re-reads looknfeel.lua's layout; this covers the moment
        # until it lands, and a session where it does not.
        prev = store.get("mosaicPrevLayout") or "dwindle"
        eval_lua("hl.config({ general = { layout = %s } })" % lua_lit(prev))


def commit_store(store, before, rebind=False):
    """Save the store and 40-panel.lua, with Mosaic's side effects around it.

    `rebind`: a key 50-desktop-scroll.lua reads changed (RELOAD_KEYS), which
    only a parse turns into binds."""
    mosaic_before_write(store, before)
    save_store(store)
    old = _bind_lines(FRAGDIR / PANEL_FRAG)
    write_panel_fragment(store)
    # A chord changed while Mosaic stays on (cycle_bind / focus_binds) is a
    # bind change too, and binds only follow a parse.
    mosaic_after_write(store, before, binds_changed=rebind or old != _bind_lines(FRAGDIR / PANEL_FRAG))


def _bind_lines(path):
    try:
        text = path.read_text()
    except OSError:
        return []
    return [l.strip() for l in text.splitlines() if "hl.bind(" in l or "hl.unbind(" in l or "hyprdrive_omarchy()" in l]


def lua_direction(direction):
    d = str(direction or "up")
    return DIR_ALIASES.get(d, d)


def hyprland_direction(direction):
    # Hyprland 0.56.2 labels scale<1 as PINCH_OUT (fingers together). Swap so
    # the panel's pinchin/pinchout match what the user actually does.
    d = lua_direction(direction)
    if d == "pinchin":
        return "pinchout"
    if d == "pinchout":
        return "pinchin"
    return d


def gesture_fields(g, include_arg=True):
    fields = [
        "fingers = %d" % int(g.get("fingers", 3)),
        "direction = %s" % lua_lit(hyprland_direction(g.get("direction", "up"))),
        "action = %s" % lua_lit(g.get("action", "overview")),
    ]
    if g.get("mods"):
        fields.append("mods = %s" % lua_lit(g["mods"]))
    if include_arg and g.get("arg"):
        fields.append("arg = %s" % lua_lit(g["arg"]))
    scale = g.get("scale", 1)
    if scale not in (1, 1.0):
        fields.append("scale = %s" % lua_lit(scale))
    if g.get("disable_inhibit"):
        fields.append("disable_inhibit = true")
    return fields


def write_gesture_fragment(gestures):
    native, plugin, workspace = [], [], []
    for g in gestures:
        action = str(g.get("action") or "overview")
        direction = str(g.get("direction") or "")
        if direction in ("click", "tap"):
            plugin.append(g)
        elif action == "workspace":
            workspace.append(g)
        elif action in NATIVE_ACTIONS:
            native.append(g)
        else:
            plugin.append(g)

    lines = [
        "-- hyprdrive fragment 35-gestures -- panel-owned trackpad gestures.",
        "-- Native Hyprland actions (close, fullscreen, ...) use hl.gesture.",
        "-- Overview follow and workspace (overview pan + desktop swipe) stay on hyprdrive.gesture.",
        "-- MACHINE-OWNED above the raw-snippet marker.",
    ]
    for g in native:
        lines.append("pcall(function() hl.gesture({ %s }) end)" % ", ".join(gesture_fields(g, include_arg=bool(g.get("arg")))))
    if workspace:
        lines.append("if hyprdrive_loaded and hyprdrive_loaded() then")
        for g in workspace:
            lines.append("    pcall(function() hl.plugin.hyprdrive.gesture({ %s }) end)" % ", ".join(gesture_fields(g)))
        lines.append("else")
        for g in workspace:
            lines.append("    pcall(function() hl.gesture({ %s }) end)" % ", ".join(gesture_fields(g, include_arg=False)))
        lines.append("end")
    if plugin:
        lines.append("if hyprdrive_loaded and hyprdrive_loaded() then")
        for g in plugin:
            lines.append("    pcall(function() hl.plugin.hyprdrive.gesture({ %s }) end)" % ", ".join(gesture_fields(g)))
        lines.append("end")
    lines.append("")
    FRAGDIR.mkdir(parents=True, exist_ok=True)
    path = FRAGDIR / GESTURE_FRAG
    write_fragment(path, compose_fragment("\n".join(lines), path))
    return path


def coerce(meta, value):
    kind = meta["kind"]
    if kind == "bool":
        if isinstance(value, bool):
            return value
        return str(value).strip().lower() in ("1", "true", "yes", "on")
    if kind == "int":
        return int(float(value))
    if kind == "float":
        return float(value)
    if kind == "enum":
        v = str(value)
        if meta.get("options") and v not in [o["value"] for o in meta["options"]]:
            raise SystemExit("hdpanel: %s must be one of %s" % (meta["key"], ", ".join(o["value"] for o in meta["options"])))
        return v
    return str(value)


def live_keys():
    """Every panel key's live value in ONE hyprctl call (--batch), ~4 ms
    instead of one process per key."""
    out = {}
    batch = "; ".join("j/getoption %s" % m["key"] for m in KEY_META if m["key"] != SLIDE_KEY)
    text = hyprctl("--batch", batch)
    if text:
        dec = json.JSONDecoder()
        i = 0
        while i < len(text):
            while i < len(text) and text[i] in " \t\r\n":
                i += 1
            if i >= len(text):
                break
            try:
                d, i = dec.raw_decode(text, i)
            except ValueError:
                # "no such option" (a key this Hyprland or plugin build does
                # not have) is plain text in the stream: skip to the next object.
                nxt = text.find("{", i + 1)
                if nxt < 0:
                    break
                i = nxt
                continue
            if not isinstance(d, dict) or "option" not in d:
                continue
            for k in ("bool", "int", "float", "str", "gradient", "vec2", "css", "custom", "data"):
                if k in d:
                    out[d["option"]] = d[k]
                    break
    if not out:  # a Hyprland without --batch: the slow path
        for meta in KEY_META:
            v = getoption(meta["key"])
            if v is not None:
                out[meta["key"]] = v
    slide = workspace_slide_live()
    if slide is not None:
        out[SLIDE_KEY] = slide
    return out


def monitor_options(current):
    """dock:monitor's choices: every monitor plus "All", made when the panel
    loads because they are whatever is plugged in. A monitor is stored by
    description (desc:...), which survives a USB-C dock renaming DP-5 to DP-6.
    A chosen monitor that is unplugged stays listed so the choice still shows."""
    opts = [{"value": "", "label": "All"}]
    try:
        mons = json.loads(hyprctl("-j", "monitors") or "[]")
    except ValueError:
        mons = []
    for m in sorted(mons, key=lambda m: (m.get("x", 0), m.get("y", 0))):
        desc, name = (m.get("description") or "").strip(), m.get("name") or ""
        if name.startswith("eDP"):
            label = "Built-in"
        else:
            label = (m.get("model") or "").strip() or name
        value = "desc:" + desc if desc else name
        opts.append({"value": value, "label": label})
    if current and current not in [o["value"] for o in opts]:
        gone = current[5:] if current.startswith("desc:") else current
        opts.append({"value": current, "label": gone.split(" 0x")[0][:24] + " (unplugged)"})
    return opts


def chord_options(key, current):
    """Mosaic's chord rows: Auto (the row's description says what it means on
    each desktop), the usual choices, None -- and whatever the config says now
    when it is something else, so a hand-set chord still shows as chosen."""
    if key == SCROLL_MODS:
        opts = [
            {"value": "SUPER", "label": "Super"},
            {"value": "SUPER + SHIFT", "label": "Super+Shift"},
            {"value": "SUPER + CTRL", "label": "Super+Ctrl"},
            {"value": "CTRL + ALT", "label": "Ctrl+Alt"},
        ]
        if current and current not in [o["value"] for o in opts]:
            opts.append({"value": current, "label": "Custom: " + current.title().replace(" ", "")})
        return opts
    if key == MOSAIC_CYCLE:
        opts = [
            {"value": "auto", "label": "Auto"},
            {"value": "SUPER + L", "label": "Super+L"},
            {"value": "SUPER + M", "label": "Super+M"},
            {"value": "none", "label": "None"},
        ]
    else:
        opts = [
            {"value": "auto", "label": "Auto"},
            {"value": "SUPER", "label": "Super"},
            {"value": "SUPER + ALT", "label": "Super+Alt"},
            {"value": "none", "label": "None"},
        ]
    if current and current not in [o["value"] for o in opts]:
        opts.insert(len(opts) - 1, {"value": current, "label": "Custom: " + current.title().replace(" ", "")})
    return opts


# ---------------------------------------------------------------- Keybinds
#
# The Keybinds section lists hyprdrive's binds as Hyprland holds them NOW, so
# it cannot claim a chord that is not bound or miss one a hand edit added.
# `hyprctl binds -j` cannot say what a Lua bind does (every one is an opaque
# `__lua` ref), so the plugin answers `hyprctl hyprdrive-binds -j` with every
# bind that calls one of its dispatchers. The layout cycle is an exec bind
# 40-panel.lua writes, found by its description.

# Which Keybinds row a bind belongs to, by the dispatcher it calls.
BIND_ROWS = {
    "overview": "overview",
    "window": "overview_select",
    "navigate": "overview_select",
    "desktop": "desktop",
    "minimize": "minimize",
    "settings": "settings",
    "focus": "focus",
    "swap": "focus",
    "hotkey": "hotkeys",
}
LAYOUT_CYCLE_DESC = "Cycle workspace layout"
MOD_BITS = [(64, "SUPER"), (4, "CTRL"), (8, "ALT"), (1, "SHIFT"), (2, "CAPS"), (16, "MOD2"), (32, "MOD3"), (128, "MOD5")]


def mods_text(mask):
    try:
        mask = int(mask)
    except (TypeError, ValueError):
        return ""
    return " + ".join(name for bit, name in MOD_BITS if mask & bit)


def chord_text(mods, key):
    return (mods + " + " if mods else "") + str(key or "")


def keybinds(live):
    """{row id: [{"chord", "dispatcher", "arg", "submap", "description"}]}, plus
    "overview" carrying the Super tap (not a bind: the plugin sees it itself)
    while plugin:hyprdrive:tap_super is on."""
    rows = {}

    def add(row, entry):
        rows.setdefault(row, []).append(entry)

    if live.get(PLUGIN + "tap_super", 1) not in (0, "0", False, "false"):
        add("overview", {"chord": "SUPER (tap)", "dispatcher": "overview", "arg": "toggle all", "submap": "", "description": "Tap Super alone"})
    try:
        ours = json.loads(hyprctl("hyprdrive-binds", "-j") or "[]")
    except ValueError:
        ours = []
    for b in ours if isinstance(ours, list) else []:
        if not isinstance(b, dict):
            continue
        name = str(b.get("dispatcher") or "")
        add(BIND_ROWS.get(name, "other"), {
            "chord": chord_text(str(b.get("mods") or ""), b.get("key")),
            "dispatcher": name,
            "arg": str(b.get("arg") or ""),
            "submap": str(b.get("submap") or ""),
            "description": str(b.get("description") or ""),
        })
    try:
        every = json.loads(hyprctl("binds", "-j") or "[]")
    except ValueError:
        every = []
    for b in every if isinstance(every, list) else []:
        if isinstance(b, dict) and b.get("description") == LAYOUT_CYCLE_DESC:
            add("layout_cycle", {
                "chord": chord_text(mods_text(b.get("modmask")), b.get("key")),
                "dispatcher": "exec",
                "arg": "hyprdrive-layout-cycle",
                "submap": str(b.get("submap") or ""),
                "description": LAYOUT_CYCLE_DESC,
            })
    return rows


# ------------------------------------------------------------ chord editor
#
# The Keybinds section's chords are editable from the panel: a row's chip
# captures a key combination and lands here as `bind-set ID CHORD`. A chord is
# spelled the way hl.bind takes it, "SUPER + SHIFT + K": the modifiers in one
# fixed order, then one key -- an xkb key name, or code:N. parse_chord() also
# takes the hyprlang spelling "SUPER SHIFT, K", "Super+Shift+K", and JSON
# {"mods": ["SUPER", "SHIFT"], "key": "K"}.

CHORD_MODS = ["SUPER", "CTRL", "ALT", "SHIFT"]
CHORD_MOD_BITS = {"SUPER": 64, "CTRL": 4, "ALT": 8, "SHIFT": 1}
MOD_ALIASES = {
    "SUPER": "SUPER", "WIN": "SUPER", "META": "SUPER", "MOD4": "SUPER", "LOGO": "SUPER",
    "CTRL": "CTRL", "CONTROL": "CTRL", "ALT": "ALT", "MOD1": "ALT", "SHIFT": "SHIFT",
}
CHORD_KEY_RE = re.compile(r"^(?:code:\d{1,3}|[A-Za-z0-9_]{1,40})$")
# Keys that are modifiers themselves: a bind ON one is a tap, not a chord.
MODIFIER_KEYS = {"SUPER_L", "SUPER_R", "CONTROL_L", "CONTROL_R", "ALT_L", "ALT_R", "SHIFT_L",
                 "SHIFT_R", "META_L", "META_R", "HYPER_L", "HYPER_R", "ISO_LEVEL3_SHIFT", "CAPS_LOCK"}
# Keys that may stand alone (no modifier): nothing types them.
SOLO_KEY_RE = re.compile(r"^(?:F\d{1,2}|PRINT|PAUSE|MENU|SCROLL_LOCK|INSERT|XF86\w+)$", re.I)
WHEEL_KEYS = {"MOUSE_DOWN": "mouse_down", "MOUSE_UP": "mouse_up"}
# The number row: hyprctl reports Omarchy's code:10..19 binds with no key.
DIGIT_CODES = {str(n % 10): 9 + n for n in range(1, 11)}


def parse_mods(text):
    """'SUPER + SHIFT' / 'super shift' / ['SUPER'] -> ['SUPER', 'SHIFT'] (fixed order)."""
    parts = text if isinstance(text, list) else re.split(r"[\s+_]+", str(text or ""))
    seen = set()
    for p in parts:
        p = str(p).strip().upper()
        if not p:
            continue
        if p not in MOD_ALIASES:
            raise ValueError("%s is not a modifier" % p)
        seen.add(MOD_ALIASES[p])
    return [m for m in CHORD_MODS if m in seen]


def parse_chord(text, wheel=False):
    """A chord in any accepted spelling -> (mods, key). ValueError says why not."""
    text = str(text or "").strip()
    if text.startswith("{"):
        try:
            d = json.loads(text)
        except ValueError:
            raise ValueError("bad JSON chord")
        mods, key = parse_mods(list(d.get("mods") or [])), str(d.get("key") or "").strip()
    elif "," in text:
        head, key = text.rsplit(",", 1)
        mods, key = parse_mods(head), key.strip()
    else:
        parts = [p.strip() for p in text.split("+")]
        if any(not p for p in parts):
            raise ValueError("empty part in %r" % text)
        key = parts.pop() if parts else ""
        mods = parse_mods(parts)
    if not key:
        raise ValueError("no key")
    if key.upper() in WHEEL_KEYS:
        if not wheel:
            raise ValueError("mouse binds are not editable here")
        return mods, WHEEL_KEYS[key.upper()]
    if key.lower().startswith("mouse"):
        raise ValueError("mouse binds are not editable here")
    if not CHORD_KEY_RE.match(key):
        raise ValueError("%r is not a key name" % key)
    key = key.lower() if key.lower().startswith("code:") else key.upper()
    if key in MOD_ALIASES or key in MODIFIER_KEYS:
        raise ValueError("%s is a modifier; add a key to it" % key)
    if key == "ESCAPE" and not mods:
        raise ValueError("Escape on its own cannot be taken")
    if not (set(mods) - {"SHIFT"}) and not SOLO_KEY_RE.match(key):
        raise ValueError("a key without Super, Ctrl or Alt would stop it typing")
    return mods, key


def format_chord(mods, key):
    return " + ".join(list(mods) + [key])


def canon_chord(text, wheel=False):
    return format_chord(*parse_chord(text, wheel))


def chord_mask(mods):
    return sum(CHORD_MOD_BITS[m] for m in mods)


def _key_code(key):
    k = str(key or "").lower()
    if k.startswith("code:"):
        try:
            return int(k[5:])
        except ValueError:
            return None
    return DIGIT_CODES.get(k)


def bind_hits(b, mask, key):
    """Does one `hyprctl binds -j` entry hold chord (mask, key)? Global binds
    only: a submap's binds (the overview's) do not compete with a chord."""
    if not isinstance(b, dict) or b.get("submap") or b.get("catch_all"):
        return False
    if int(b.get("modmask") or 0) != mask:
        return False
    k = str(key).lower()
    bk = str(b.get("key") or "").lower()
    code = _key_code(k)
    if bk:
        return bk == k or (code is not None and _key_code(bk) == code)
    kc = int(b.get("keycode") or 0)
    if kc:
        return code is not None and kc == code
    # hyprctl reports a code:N bind with an empty key and keycode 0 (Omarchy's
    # Super+1..0): the number keys' are told apart by their description.
    m = re.search(r"workspace (\d+)\b", str(b.get("description") or ""))
    if m and code is not None and 10 <= code <= 19:
        return int(m.group(1)) % 10 == (code - 9) % 10
    return False


def bind_label(b):
    desc = str(b.get("description") or "").strip()
    if desc:
        return desc
    d, a = str(b.get("dispatcher") or ""), str(b.get("arg") or "")
    if d and d != "__lua":
        return (d + " " + a).strip()
    return "a bind in your config"


def chord_owners(chords, binds, own):
    """Who holds any of `chords` ([(mods, key)]) right now.

    -> [{"kind": "hyprdrive" | "other", "id": row id or "", "description",
         "chord"}]. `own(b)` names the Keybinds row a bind is hyprdrive's
    (by its description), or None for someone else's."""
    out, seen = [], set()
    for mods, key in chords:
        mask = chord_mask(mods)
        for b in binds:
            if not bind_hits(b, mask, key):
                continue
            rid = own(b)
            label = bind_label(b)
            ident = (rid or "", label, format_chord(mods, key))
            if ident in seen:
                continue
            seen.add(ident)
            out.append({"kind": "hyprdrive" if rid else "other", "id": rid or "",
                        "description": label, "chord": format_chord(mods, key)})
    return out


CAPTURE_SUBMAP = "hyprdrive-capture"
CAPTURE_SECONDS = 30
CAPTURE_TOKEN = STATE / "capture.token"


def current_submap():
    out = hyprctl("submap")
    return (out or "").strip()


def capture_submap_lua():
    # One bind: a NON-consuming Escape that leaves the submap, so Escape still
    # reaches the panel (it cancels there) and a panel that died mid-capture
    # cannot leave the desktop without its binds.
    return ("hl.define_submap(%s, function() hl.bind('Escape', hl.dsp.submap('reset'), "
            "{ non_consuming = true, description = 'Leave Hyprdrive key capture' }) end)" % lua_lit(CAPTURE_SUBMAP))


def cmd_capture(args):
    """capture on|off: while the panel captures a chord, Hyprland sits in an
    (almost) empty submap, so Super+Q and friends reach the panel instead of
    closing a window. A detached watchdog leaves it after CAPTURE_SECONDS
    whatever happens to the panel."""
    what = args[0] if args else ""
    if what == "on":
        try:
            binds = json.loads(hyprctl("binds", "-j") or "[]")
        except ValueError:
            binds = []
        defined = any(isinstance(b, dict) and b.get("submap") == CAPTURE_SUBMAP for b in binds)
        ok = (defined or eval_lua(capture_submap_lua())) and eval_lua("hl.dispatch(hl.dsp.submap(%s))" % lua_lit(CAPTURE_SUBMAP))
        if ok:
            # The watchdog leaves only THIS capture's submap: a later capture
            # rewrites the token, and its own watchdog takes over.
            token = "%d.%d" % (os.getpid(), int(time.time() * 1000))
            try:
                STATE.mkdir(parents=True, exist_ok=True)
                replace_file(CAPTURE_TOKEN, token)  # private, like every panel write
                subprocess.Popen([sys.executable, os.path.abspath(__file__), "capture", "watchdog", token],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
            except OSError:
                pass
        print(json.dumps({"ok": bool(ok), "submap": CAPTURE_SUBMAP if ok else ""}))
        return 0
    if what in ("off", "watchdog"):
        if what == "watchdog":
            time.sleep(CAPTURE_SECONDS)
            try:
                if CAPTURE_TOKEN.read_text() != (args[1] if len(args) > 1 else ""):
                    return 0
            except OSError:
                return 0
        try:
            CAPTURE_TOKEN.unlink()
        except OSError:
            pass
        left = False
        if current_submap() == CAPTURE_SUBMAP:
            left = eval_lua("hl.dispatch(hl.dsp.submap('reset'))")
        if what == "off":
            print(json.dumps({"ok": True, "left": bool(left)}))
        return 0
    raise SystemExit("hdpanel: capture on|off")


# The Keybinds rows the panel edits. A switch row's chord (minimize, settings)
# lives in panel.json "bindChords" (only when not the default); the others are
# plugin keys: Mosaic's cycle chord, its focus modifiers, the scroll modifiers.
CHORD_DEFAULTS = {bid: spec[1] for bid, spec in BIND_SWITCHES.items()}
KEY_ROWS = {
    "layout_cycle": (MOSAIC_CYCLE, "chord"),
    "focus": (MOSAIC_FOCUS, "arrows"),
    "desktop": (SCROLL_MODS, "wheel"),
}
# Which row a bind of ours is, by the description its fragment gave it.
OWN_DESCS = {
    "Minimize window": "minimize",
    "Hyprdrive settings": "settings",
    LAYOUT_CYCLE_DESC: "layout_cycle",
    "Next desktop (empty ones too)": "desktop",
    "Previous desktop (empty ones too)": "desktop",
}
ROW_NAMES = {
    "minimize": "Minimize",
    "settings": "Open these settings",
    "layout_cycle": "Mosaic layout cycle",
    "focus": "Mosaic-aware focus and swap",
    "desktop": "Scroll through desktops",
    "hotkeys": "Dock hotkeys",
    "overview": "Overview",
    "overview_select": "Pick a window in the overview",
    "other": "a hyprdrive bind",
}
ARROWS = ["LEFT", "RIGHT", "UP", "DOWN"]


def bind_chords(store):
    """Each switch row's chord: the panel's choice, else the default."""
    saved = store.get("bindChords") or {}
    out = {}
    for rid, d in CHORD_DEFAULTS.items():
        try:
            out[rid] = canon_chord(saved[rid]) if saved.get(rid) else d
        except ValueError:
            out[rid] = d
    return out


def own_row(store):
    """-> own(bind): the Keybinds row a live bind is hyprdrive's, or None.

    The plugin's own list (hyprctl hyprdrive-binds) first -- it knows every
    bind that calls one of its dispatchers -- then the descriptions."""
    ours = {}
    try:
        listed = json.loads(hyprctl("hyprdrive-binds", "-j") or "[]")
    except ValueError:
        listed = []
    for b in listed if isinstance(listed, list) else []:
        if not isinstance(b, dict) or b.get("submap"):
            continue
        try:
            mask = chord_mask(parse_mods(str(b.get("mods") or "")))
        except ValueError:
            continue
        ours[(mask, str(b.get("key") or "").lower())] = BIND_ROWS.get(str(b.get("dispatcher") or ""), "other")

    def own(b):
        hit = ours.get((int(b.get("modmask") or 0), str(b.get("key") or "").lower()))
        if hit:
            return hit
        d = str(b.get("description") or "")
        if d in OWN_DESCS:
            return OWN_DESCS[d]
        if re.match(r"Dock app \d+$", d):
            return "hotkeys"
        return None
    return own


def expand_chord(mods, key):
    """A checked chord -> every chord it stands for: the wheel's two
    directions, the four arrows (Mosaic's focus binds)."""
    if key in ("mouse_down", "mouse_up"):
        return [(mods, "mouse_down"), (mods, "mouse_up")]
    if key == "ARROWS":
        return [(mods, a) for a in ARROWS]
    return [(mods, key)]


def check_chord(store, rid, chord, binds=None):
    """bind-check: who holds `chord` now, minus the row itself. A wheel chord
    ("SUPER + ALT + mouse_down") checks both directions; "MODS + ARROWS" all
    four arrows."""
    mods, key = parse_chord(chord, wheel=True)
    if key == "ARROWS" and not mods:
        raise ValueError("the arrows need a modifier")
    owners = chord_owners(expand_chord(mods, key), live_binds() if binds is None else binds, own_row(store))
    mine = [o for o in owners if o["kind"] == "hyprdrive" and o["id"] == rid]
    others = [o for o in owners if o not in mine]
    for o in others:
        if o["kind"] == "hyprdrive":
            o["row"] = ROW_NAMES.get(o["id"], o["id"])
    return {"ok": True, "chord": format_chord(mods, key), "self": bool(mine), "owners": others}


def live_binds():
    try:
        out = json.loads(hyprctl("binds", "-j") or "[]")
    except ValueError:
        return []
    return out if isinstance(out, list) else []


def free_rows(store, ids):
    """Turn hyprdrive's own rows off so a chord can move to another one.
    -> the plugin keys that changed (already in the store)."""
    keys = []
    for rid in ids:
        if rid in BIND_SWITCHES:
            store.setdefault("binds", {})[rid] = False
        elif rid == "layout_cycle":
            keys.append((MOSAIC_CYCLE, "none"))
        elif rid == "focus":
            keys.append((MOSAIC_FOCUS, "none"))
        elif rid == "desktop":
            keys.append((SCROLL_DESKTOPS, False))
        elif rid == "hotkeys":
            keys.append((HOT_KEYS, False))
    for k, v in keys:
        store.setdefault("keys", {})[k] = v
    return keys


def key_row_value(rid, what):
    """bind-set for a key row: the value to store, canonical."""
    key, kind = KEY_ROWS[rid]
    low = what.strip().lower()
    if low == "default":
        return next(m for m in KEY_META if m["key"] == key)["default"]
    if kind != "wheel" and low in ("auto", "none"):
        return low
    if kind == "chord":
        return canon_chord(what)
    mods = parse_mods(what)
    if not (set(mods) - {"SHIFT"}):
        raise ValueError("hold Super, Ctrl or Alt")
    return " + ".join(mods)


def checked_form(rid, value):
    """The chord bind-check looks at for a row's value, or None (auto/none)."""
    if value in ("auto", "none"):
        return None
    if rid in KEY_ROWS:
        kind = KEY_ROWS[rid][1]
        if kind == "wheel":
            return value + " + mouse_down"
        if kind == "arrows":
            return value + " + ARROWS"
    return value


def plugin_version():
    """The loaded plugin's version (`hyprctl plugin list`), for a native
    install with no manifest.json beside it."""
    try:
        for p in json.loads(hyprctl("plugin", "list", "-j") or "[]"):
            if isinstance(p, dict) and p.get("name") == "hyprdrive":
                return str(p.get("version") or "")
    except ValueError:
        pass
    return ""


def dump():
    store = load_store()
    live = live_keys()
    # Hyprlang reports an empty string option as [[EMPTY]].
    mon_key = PLUGIN + "dock:monitor"
    for k in (mon_key, MOSAIC_CYCLE, MOSAIC_FOCUS, SCROLL_MODS):
        if live.get(k) == "[[EMPTY]]":
            live[k] = ""

    def with_options(m):
        if m["key"] == mon_key:
            return dict(m, options=monitor_options(live.get(mon_key, "")))
        if m["key"] in (MOSAIC_CYCLE, MOSAIC_FOCUS):
            return dict(m, options=chord_options(m["key"], chord_setting(store, m["key"]) if live.get(m["key"]) is None else (live.get(m["key"]) or "auto")))
        if m["key"] == SCROLL_MODS:
            return dict(m, options=chord_options(SCROLL_MODS, live.get(SCROLL_MODS) or "SUPER"))
        return m
    meta = [with_options(m) for m in KEY_META]
    gestures = store.get("gestures")
    if not gestures:
        gestures = [dict(g) for g in DEFAULT_GESTURES]
    else:
        gestures = [dict(g) for g in gestures]
        seen = {(int(g.get("fingers", 0)), str(g.get("direction") or "")) for g in gestures}
        for g in DEFAULT_GESTURES:
            if g["direction"] == "click" and (g["fingers"], "click") not in seen:
                gestures.append(dict(g))
    version = ""
    try:
        # Beside the copied panel (plugins/dragos.hyprdrive/manifest.json), or at
        # the repository root when this runs from a checkout -- a marketplace
        # install or a dev tree, where hdpanel sits in omarchy-plugin/bin/.
        here = pathlib.Path(__file__).resolve().parent.parent
        mf = next((p for p in (here / "manifest.json", here.parent / "manifest.json") if p.is_file()), None)
        version = json.loads(mf.read_text()).get("version", "") if mf else ""
    except (OSError, ValueError):
        pass
    if not version:
        version = plugin_version()
    return {
        "version": version,
        "integration": integration(),
        "keys": live,
        "owned": store.get("keys", {}),
        "gestures": gestures,
        "gesturesOwned": store.get("gestures") is not None,
        "profiles": store.get("profiles", {"ac": {}, "battery": {}}),
        "profileMode": store.get("profileMode", "auto"),
        "roundedRadius": store.get("roundedRadius", 24),
        "onBattery": on_battery(),
        "meta": meta,
        "actions": ACTIONS,
        "directions": DIRECTIONS,
        "binds": keybinds(live),
        "bindSwitches": bind_switches(store),
        "bindChords": bind_chords(store),
        "chordDefaults": CHORD_DEFAULTS,
    }


def cmd_dump(_args):
    json.dump(dump(), sys.stdout, indent=1)
    sys.stdout.write("\n")
    return 0


def set_keys(pairs, preview=False):
    coerced = []
    for key, value in pairs:
        meta = next((m for m in KEY_META if m["key"] == key), None)
        if meta is None:
            raise SystemExit("hdpanel: unknown key %s" % key)
        coerced.append((key, coerce(meta, value)))
    store = load_store()
    asked = dict(coerced)
    # Mosaic off takes "Mosaic is the default" with it, and the default cannot
    # be switched on by itself: it would set a layout Super+L cannot leave
    # through Mosaic's cycle.
    if asked.get(MOSAIC_ON) is False and MOSAIC_DEFAULT not in asked:
        coerced.append((MOSAIC_DEFAULT, False))
    if asked.get(MOSAIC_DEFAULT) is True and not asked.get(MOSAIC_ON, mosaic_state(store)[0]):
        raise SystemExit("hdpanel: turn Mosaic on before making it the default")
    before = mosaic_state(store)
    if not apply_live_many(coerced, store):
        raise SystemExit("hdpanel: live apply failed")
    if preview:
        return coerced
    store.setdefault("keys", {})
    for key, value in coerced:
        store["keys"][key] = value
        if key == PLUGIN + "dock:corner_radius" and int(value) > 0:
            store["roundedRadius"] = int(value)
    commit_store(store, before, rebind=any(key in RELOAD_KEYS for key, _ in coerced))
    if _NEEDS_RELOAD:
        # Animations back on with no snapshot to restore them from (off
        # Omarchy): 40-panel.lua no longer switches them off, so a re-parse
        # brings back exactly what the user's config says.
        hyprctl("reload")
    return coerced


def cmd_set(args):
    if len(args) < 2 or len(args) % 2 != 0:
        raise SystemExit("hdpanel: set KEY VALUE [KEY VALUE ...]")
    pairs = list(zip(args[0::2], args[1::2]))
    coerced = set_keys(pairs, preview=False)
    print(json.dumps({"ok": True, "keys": {k: v for k, v in coerced}}))
    return 0


def cmd_seed(args):
    """Install-time defaults: each KEY VALUE is stored only if the user has
    not set that key already, and 40-panel.lua is rewritten -- no live apply,
    so it works with no Hyprland running (a running one reloads the fragment).
    The native installer seeds the search tools on (user, 2026-10-15:
    "translation and dictionary ... make sure that works and is part of the
    installation")."""
    if len(args) < 2 or len(args) % 2 != 0:
        raise SystemExit("hdpanel: seed KEY VALUE [KEY VALUE ...]")
    store = load_store()
    owned = store.setdefault("keys", {})
    seeded = {}
    for key, value in zip(args[0::2], args[1::2]):
        meta = next((m for m in KEY_META if m["key"] == key), None)
        if meta is None:
            raise SystemExit("hdpanel: unknown key %s" % key)
        if key not in owned:
            owned[key] = coerce(meta, value)
            seeded[key] = owned[key]
    if seeded:
        before = mosaic_state(store)
        commit_store(store, before)
        # A running Hyprland does not re-read the fragment by itself: apply
        # live too, best effort (no Hyprland -- an install from a TTY -- is fine).
        try:
            apply_live_many(list(seeded.items()), store)
        except Exception:
            pass
    print(json.dumps({"ok": True, "seeded": seeded}))
    return 0


def cmd_preview(args):
    if len(args) < 2 or len(args) % 2 != 0:
        raise SystemExit("hdpanel: preview KEY VALUE [KEY VALUE ...]")
    pairs = list(zip(args[0::2], args[1::2]))
    coerced = set_keys(pairs, preview=True)
    print(json.dumps({"ok": True, "preview": True, "keys": {k: v for k, v in coerced}}))
    return 0


def default_of(meta):
    return meta.get("default")


def reset_keys(store, group):
    """A group's keys back to their defaults, live, and out of the store."""
    metas = [m for m in KEY_META if m.get("group") == group and default_of(m) is not None]
    if not metas:
        return
    pairs = [(m["key"], coerce(m, default_of(m))) for m in metas]
    before = mosaic_state(store)
    apply_live_many(pairs, store)
    owned = store.setdefault("keys", {})
    for key, _ in pairs:
        owned.pop(key, None)
    commit_store(store, before, rebind=any(key in RELOAD_KEYS for key, _ in pairs))


def cmd_reset(args):
    """Restore one panel section to hyprdrive's shipped values.

    The section's keys go back to their defaults live AND leave the store, so
    40-panel.lua stops owning them and a later hyprdrive default change is
    picked up instead of a frozen copy of today's.
    """
    if not args:
        raise SystemExit("hdpanel: reset GROUP")
    group = args[0]
    if group == "gestures":
        store = load_store()
        store["gestures"] = None
        save_store(store)
        write_gesture_fragment([dict(g) for g in DEFAULT_GESTURES])
        # The section's switches too, written before the reload re-reads them.
        reset_keys(store, group)
        if hyprctl("reload") is None:
            raise SystemExit("hdpanel: wrote gestures but hyprctl reload failed")
        print(json.dumps({"ok": True, "group": group}))
        return 0
    metas = [m for m in KEY_META if m.get("group") == group and default_of(m) is not None]
    if group == "keybinds":
        # The Keybinds section edits Mosaic's two chords too: its Restore
        # defaults puts them back to "auto" with everything else it shows.
        metas += [m for m in KEY_META if m["key"] in (MOSAIC_CYCLE, MOSAIC_FOCUS)]
    if not metas:
        raise SystemExit("hdpanel: nothing to reset in %s" % group)
    pairs = [(m["key"], coerce(m, default_of(m))) for m in metas]
    store = load_store()
    before = mosaic_state(store)
    if not apply_live_many(pairs, store):
        raise SystemExit("hdpanel: live reset failed")
    owned = store.setdefault("keys", {})
    for key, _ in pairs:
        owned.pop(key, None)
    if group == "dock":
        store["roundedRadius"] = 24
    if group == "keybinds":
        store.pop("binds", None)
        store.pop("bindChords", None)
    commit_store(store, before, rebind=True if group == "keybinds" else any(key in RELOAD_KEYS for key, _ in pairs))
    if _NEEDS_RELOAD:
        hyprctl("reload")
    print(json.dumps({"ok": True, "group": group, "keys": {k: v for k, v in pairs}}))
    return 0


def cmd_bind_set(args):
    """bind-set ID on|off|default|CHORD [--replace]

    ID is a switch row (minimize|settings: on/off, or a CHORD that also turns it on, kept in
    panel.json "bindChords") or a key row -- layout_cycle (a CHORD, auto,
    none), focus (MODIFIERS for the arrows, auto, none), desktop (the scroll
    MODIFIERS). "default" puts the row's default back. A CHORD is "SUPER +
    SHIFT + K", "SUPER SHIFT, K" or JSON {"mods": [...], "key": "K"}.

    Like the switches, a chord is taken from whatever else had it: 40-panel.lua
    (or 50-desktop-scroll.lua) unbinds it before binding. --replace also turns
    off hyprdrive's OWN row that had it, so two rows never fight over one."""
    replace = "--replace" in args
    args = [a for a in args if a != "--replace"]
    ids = list(BIND_SWITCHES) + list(KEY_ROWS)
    if len(args) != 2 or args[0] not in ids:
        raise SystemExit("hdpanel: bind-set %s on|off|default|CHORD [--replace]" % "|".join(ids))
    rid, what = args
    store = load_store()
    before = mosaic_state(store)
    out = {"ok": True, "bind": rid}
    if rid in BIND_SWITCHES and what.lower() in ("on", "off"):
        store.setdefault("binds", {})[rid] = what.lower() == "on"
        out["on"] = what.lower() == "on"
        commit_store(store, before, rebind=True)
        print(json.dumps(out))
        return 0
    try:
        if rid in BIND_SWITCHES:
            value = CHORD_DEFAULTS[rid] if what.lower() == "default" else canon_chord(what)
        else:
            value = key_row_value(rid, what)
        form = checked_form(rid, value)
        found = check_chord(store, rid, form) if form else {"owners": []}
    except ValueError as e:
        raise SystemExit("hdpanel: %s" % e)
    out["took"] = sorted({o["description"] for o in found["owners"] if o["kind"] == "other"})
    mine = sorted({o["id"] for o in found["owners"] if o["kind"] == "hyprdrive"})
    changed = []
    if replace and mine:
        changed = free_rows(store, mine)
        out["freed"] = mine
    elif mine:
        out["shared"] = mine
    if rid in BIND_SWITCHES:
        saved = store.setdefault("bindChords", {})
        if value == CHORD_DEFAULTS[rid]:
            saved.pop(rid, None)
        else:
            saved[rid] = value
        store.setdefault("binds", {})[rid] = True
        out.update(on=True, chord=value)
    else:
        key = KEY_ROWS[rid][0]
        changed.append((key, value))
        store.setdefault("keys", {})[key] = value
        out["value"] = value
    if changed and not apply_live_many(changed, store):
        raise SystemExit("hdpanel: live apply failed")
    commit_store(store, before, rebind=True)
    print(json.dumps(out))
    return 0


def cmd_bind_check(args):
    """bind-check CHORD [ID]: who holds CHORD right now (hyprctl binds), as
    JSON -- {"chord", "self", "owners": [{"kind", "id", "row", "description"}]}.
    "MODS + mouse_down" checks the wheel, "MODS + ARROWS" the four arrows. A
    chord that does not parse answers {"ok": false, "error"}, never exits
    non-zero: the panel reads the answer either way."""
    if not args:
        raise SystemExit("hdpanel: bind-check CHORD [ID]")
    try:
        print(json.dumps(check_chord(load_store(), args[1] if len(args) > 1 else "", args[0])))
    except ValueError as e:
        print(json.dumps({"ok": False, "error": str(e)}))
    return 0


def cmd_gestures_set(args):
    raw = args[0] if args else sys.stdin.read()
    gestures = json.loads(raw)
    if not isinstance(gestures, list):
        raise SystemExit("hdpanel: gestures-set expects a JSON array")
    for g in gestures:
        if isinstance(g, dict) and g.get("direction"):
            g["direction"] = lua_direction(g["direction"])
    store = load_store()
    store["gestures"] = gestures
    save_store(store)
    write_gesture_fragment(gestures)
    # Re-parse so native hl.gesture and hyprdrive.gesture replace the previous map.
    if hyprctl("reload") is None:
        raise SystemExit("hdpanel: wrote gestures but hyprctl reload failed")
    print(json.dumps({"ok": True, "count": len(gestures)}))
    return 0


def profile_key(key):
    meta = next((m for m in KEY_META if m["key"] == key), None)
    return meta is not None and meta.get("group") not in PROFILE_SKIP


def snapshot_keys():
    live = live_keys()
    store = load_store()
    live.update(store.get("keys", {}))
    return {k: v for k, v in live.items() if profile_key(k)}


def cmd_profile_save(args):
    name = args[0]
    if name not in ("ac", "battery"):
        raise SystemExit("hdpanel: profile is ac or battery")
    store = load_store()
    store.setdefault("profiles", {})[name] = snapshot_keys()
    save_store(store)
    print(json.dumps({"ok": True, "profile": name, "keys": len(store["profiles"][name])}))
    return 0


def apply_profile(name):
    store = load_store()
    prof = store.get("profiles", {}).get(name) or {}
    if not prof:
        return 0
    pairs = []
    for k, v in prof.items():
        meta = next((m for m in KEY_META if m["key"] == k), None)
        if meta is None or meta.get("group") in PROFILE_SKIP:
            continue
        v = coerce(meta, v)
        pairs.append((k, v))
        store.setdefault("keys", {})[k] = v
    if pairs and not apply_live_many(pairs, store):
        raise SystemExit("hdpanel: profile apply failed")
    save_store(store)
    write_panel_fragment(store)
    if _NEEDS_RELOAD:
        hyprctl("reload")
    return len(pairs)


def cmd_profile_apply(args):
    name = args[0]
    if name == "auto":
        name = "battery" if on_battery() else "ac"
    n = apply_profile(name)
    print(json.dumps({"ok": True, "profile": name, "applied": n, "onBattery": on_battery()}))
    return 0


def cmd_profile_auto(_args):
    """The closed panel's power watcher: apply the matching profile, but only
    in auto mode -- a forced AC/battery choice is left alone."""
    store = load_store()
    if store.get("profileMode", "auto") != "auto":
        print(json.dumps({"ok": True, "skipped": "mode is %s" % store.get("profileMode")}))
        return 0
    name = "battery" if on_battery() else "ac"
    n = apply_profile(name)
    print(json.dumps({"ok": True, "profile": name, "applied": n}))
    return 0


def cmd_profile_mode(args):
    mode = args[0]
    if mode not in ("auto", "ac", "battery"):
        raise SystemExit("hdpanel: profile-mode is auto, ac, or battery")
    store = load_store()
    store["profileMode"] = mode
    save_store(store)
    if mode == "auto":
        apply_profile("battery" if on_battery() else "ac")
    else:
        apply_profile(mode)
    print(json.dumps({"ok": True, "profileMode": mode, "onBattery": on_battery()}))
    return 0


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print("hdpanel dump|set|preview|reset GROUP|bind-set ID on|off|default|CHORD [--replace]|bind-check CHORD [ID]|capture on|off|gestures-set|profile-save|profile-apply|profile-mode")
        return 0
    cmd = argv[1]
    args = argv[2:]
    fn = {
        "dump": cmd_dump,
        "set": cmd_set,
        "seed": cmd_seed,
        "preview": cmd_preview,
        "gestures-set": cmd_gestures_set,
        "profile-save": cmd_profile_save,
        "profile-apply": cmd_profile_apply,
        "profile-mode": cmd_profile_mode,
        "reset": cmd_reset,
        "bind-set": cmd_bind_set,
        "bind-check": cmd_bind_check,
        "capture": cmd_capture,
        "profile-auto": cmd_profile_auto,
    }.get(cmd)
    if not fn:
        raise SystemExit("hdpanel: unknown command %s" % cmd)
    return fn(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
