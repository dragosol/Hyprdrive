# What "auto" means for those two. The cycle is Super+L on EVERY desktop: on
# Omarchy it replaces the two-way layout toggle Omarchy's bindings.lua ships
# there, and on plain Hyprland it is the same chord, so Super+L means the same
# thing wherever Hyprdrive runs (J4/A18). It is bound inside hyprdrive_loaded()
# only, so a missing plugin leaves whatever the config bound there itself, and
# cycle_bind = "none" (or another chord) keeps a Super+L of your own. The
# focus binds' "auto" stays Omarchy's Super+arrows there and nothing here:
# the arrows are the user's own on plain Hyprland (A20).
CYCLE_CHORD = "SUPER + L"
OMARCHY_FOCUS_MODS = "SUPER"


def _layout_cycle():
    """Super+L's script while Mosaic is on, by absolute path.

    A native install (`make install`) puts it on PATH as
    $PREFIX/bin/hyprdrive-layout-cycle, and this file lives in
    $PREFIX/lib/hyprdrive -- bind that one. Everywhere else (the Omarchy
    panel, a dev checkout) it ships beside this file."""
    here = pathlib.Path(__file__).resolve().parent
    installed = here.parent.parent / "bin" / "hyprdrive-layout-cycle"
    if here.name == "hyprdrive" and here.parent.name == "lib" and os.access(installed, os.X_OK):
        return installed
    return here / "hd-layout-cycle"


LAYOUT_CYCLE = _layout_cycle()
# Where omarchy-hyprland-workspace-layout-toggle (and hd-layout-cycle) persist
# each workspace's layout ON OMARCHY. Omarchy hard-codes ~/.local/state, so
# this does too; its workspace-layouts.lua replays the files on every parse.
OMARCHY_LAYOUTS = pathlib.Path(os.path.expanduser("~/.local/state/omarchy/workspace-layouts"))
# ...and everywhere else (A18): one fragment of ours, which the loader sources
# like every other, so a mosaic workspace survives a reload or a reboot with no
# Omarchy replaying anything. hd-layout-cycle writes it; the format is one
# hl.workspace_rule line per workspace.
NATIVE_LAYOUTS = FRAGDIR / "45-workspace-layouts.lua"
LAYOUT_RULE = re.compile(r'hl\.workspace_rule\(\{\s*workspace\s*=\s*"(-?\d+)"\s*,\s*layout\s*=\s*"([a-z_]+)"\s*\}\)')


_INTEGRATION = None


def integration():
    """'omarchy' | 'none' -- Integration.hpp's answer, asked once per run.

    Through scripts/hyprdrive-integration when it is installed (on PATH, or in
    the bin/ beside a native PREFIX's lib/hyprdrive), so this, the plugin and
    the installer cannot disagree. The marketplace copy of the Omarchy panel has
    no CLI beside it; then the same rule is applied here, the running plugin's
    own answer first.
    """
    global _INTEGRATION
    if _INTEGRATION is not None:
        return _INTEGRATION
    here = pathlib.Path(__file__).resolve().parent
    cands = [shutil.which("hyprdrive-integration"),
             str(here.parent.parent / "bin" / "hyprdrive-integration"),
             os.path.expanduser("~/.local/bin/hyprdrive-integration")]
    env = _env() or dict(os.environ)
    for c in cands:
        if c and os.access(c, os.X_OK):
            try:
                r = subprocess.run([c], capture_output=True, text=True, timeout=10, env=env)
                name = (r.stdout or "").split("\n", 1)[0].strip()
                if name in ("omarchy", "none"):
                    _INTEGRATION = name
                    return name
            except (OSError, subprocess.SubprocessError):
                pass
    if os.environ.get("HYPRDRIVE_NO_OMARCHY") == "1":
        _INTEGRATION = "none"
        return _INTEGRATION
    forced = os.environ.get("HYPRDRIVE_INTEGRATION", "")
    if forced in ("omarchy", "none"):
        _INTEGRATION = forced
        return forced
    out = hyprctl("hyprdrive-integration")
    name = (out or "").split("\n", 1)[0].strip()
    if name in ("omarchy", "none"):
        _INTEGRATION = name
        return name
    state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    on_path = any(os.path.isfile(os.path.join(d or ".", "omarchy")) and os.access(os.path.join(d or ".", "omarchy"), os.X_OK)
                  for d in os.environ.get("PATH", "").split(":"))
    on_path = (on_path or os.access(os.path.expanduser("~/.local/share/omarchy/bin/omarchy"), os.X_OK)
               or bool(os.environ.get("OMARCHY_PATH")))
    _INTEGRATION = "omarchy" if on_path and os.path.exists(os.path.join(state, "omarchy", "current")) else "none"
    return _INTEGRATION


def omarchy():
    return integration() == "omarchy"

