#!/bin/bash

# The layout cycle while the settings' Mosaic switch is on: 40-panel.lua binds
# it to plugin:hyprdrive:mosaic:cycle_bind -- Super+L on Omarchy (after
# unbinding Omarchy's omarchy-hyprland-workspace-layout-toggle), no chord at all
# on plain Hyprland unless one is chosen.
#
# Cycles the active workspace dwindle -> scrolling -> mosaic -> dwindle. With
# plugin:hyprdrive:mosaic:enabled off, or the plugin not loaded at all, it is
# Omarchy's toggle exactly (dwindle <-> scrolling): "mosaic" is a layout the
# plugin registers, and a workspace rule naming it without the plugin would
# leave that workspace on whatever Hyprland falls back to.
#
# WHERE THE CHOICE PERSISTS depends on the desktop (Integration, audit A18):
#   - Omarchy: Omarchy's own directory, one one-line file per workspace, on
#     purpose -- default/hypr/workspace-layouts.lua replays those files on every
#     config parse, so a mosaic workspace survives a reload or a reboot the same
#     way a scrolling one does, and Omarchy's own toggle keeps reading what this
#     one wrote.
#   - Plain Hyprland: nothing replays that directory, so the layout was lost on
#     the next reload. Here it goes into a fragment of ours,
#     ~/.config/hypr/hyprdrive/45-workspace-layouts.lua, which the hyprdrive
#     loader sources like every other fragment. One line per workspace (hdpanel
#     rewrites the same file when Mosaic is switched off).
# The confirmation is omarchy-notification-send on Omarchy, notify-send elsewhere.

ACTIVE=$(hyprctl activeworkspace -j) || exit 1
ACTIVE_WORKSPACE=$(jq -r '.id' <<<"$ACTIVE")
[[ $ACTIVE_WORKSPACE =~ ^-?[0-9]+$ ]] || exit 1
CURRENT_LAYOUT=$(jq -r '.tiledLayout' <<<"$ACTIVE")

# "no such option" (plugin not loaded, or a build without Mosaic) is plain
# text, not JSON, so jq fails and Mosaic stays out of the cycle.
mosaic_enabled() {
  hyprctl getoption plugin:hyprdrive:mosaic:enabled -j 2>/dev/null |
    jq -e 'if has("bool") then .bool elif has("int") then .int != 0 else false end' >/dev/null 2>&1
}

# omarchy | none: the CLI beside us (a native install), on PATH, the running
# plugin's own answer, then "none". Mosaic needs the plugin anyway, so the
# hyprctl step answers in every case that matters.
integration() {
  local here cli name
  here=$(dirname "$(readlink -f "$0")")
  for cli in "$here/../../bin/hyprdrive-integration" "$(command -v hyprdrive-integration 2>/dev/null)"; do
    if [[ -n $cli && -x $cli ]]; then
      name=$("$cli" 2>/dev/null | head -1)
      [[ $name == omarchy || $name == none ]] && { echo "$name"; return; }
    fi
  done
  name=$(hyprctl hyprdrive-integration 2>/dev/null | head -1)
  [[ $name == omarchy ]] && { echo omarchy; return; }
  echo none
}

case "$CURRENT_LAYOUT" in
  dwindle) NEW_LAYOUT=scrolling ;;
  scrolling)
    if mosaic_enabled; then
      NEW_LAYOUT=mosaic
    else
      NEW_LAYOUT=dwindle
    fi
    ;;
  *) NEW_LAYOUT=dwindle ;;
esac

RULE=$(printf 'hl.workspace_rule({ workspace = "%s", layout = "%s" })' "$ACTIVE_WORKSPACE" "$NEW_LAYOUT")
DESKTOP=$(integration)

if [[ $DESKTOP == omarchy ]]; then
  LAYOUTS_DIR="$HOME/.local/state/omarchy/workspace-layouts"
  mkdir -p "$LAYOUTS_DIR"
  printf '%s\n' "$RULE" >"$LAYOUTS_DIR/$ACTIVE_WORKSPACE.lua"
else
  FRAGDIR=${HYPRDRIVE_FRAGMENTS:-${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprdrive}
  FRAG="$FRAGDIR/45-workspace-layouts.lua"
  mkdir -p "$FRAGDIR"
  TMP=$(mktemp "$FRAG.XXXXXX") || exit 1
  {
    echo "-- hyprdrive fragment 45-workspace-layouts -- each workspace's tiled layout,"
    echo "-- as the layout cycle (hd-layout-cycle) last left it. Written by hyprdrive;"
    echo "-- one line per workspace. Not used on Omarchy, which keeps its own."
    # Every other workspace's line, then this one's (sorted by number).
    { [[ -f $FRAG ]] && grep -E '^hl\.workspace_rule\(\{ workspace = "-?[0-9]+"' "$FRAG" |
        grep -vF "workspace = \"$ACTIVE_WORKSPACE\","
      echo "$RULE"; } | sort -t'"' -k2,2n
  } >"$TMP"
  # The fragment is config: keep the mode a previous one had (0644 default).
  [[ -f $FRAG ]] && chmod --reference="$FRAG" "$TMP" 2>/dev/null || chmod 644 "$TMP"
  mv -f "$TMP" "$FRAG"
fi

hyprctl eval "$RULE" >/dev/null 2>&1 || \
  hyprctl keyword workspace "$ACTIVE_WORKSPACE, layout:$NEW_LAYOUT"

LABEL=$NEW_LAYOUT
[[ $NEW_LAYOUT == mosaic ]] && LABEL=Mosaic
if [[ $DESKTOP == omarchy ]] && command -v omarchy-notification-send >/dev/null 2>&1; then
  omarchy-notification-send -g 󱂬 "Workspace layout set to $LABEL"
elif command -v notify-send >/dev/null 2>&1; then
  notify-send -a Hyprdrive -t 2000 "Workspace layout set to $LABEL"
fi
exit 0
